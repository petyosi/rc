#!/usr/bin/env bash

set -u

usage() {
  cat <<'EOF'
Usage: git sweep-gone [--apply]

Remove clean worktrees and local branches fully contained in origin/main, or
whose tip is contained in a GitHub PR head merged into origin/main.
Find PRs by branch name and commit, including older local tips.
Keep main, master, the origin default branch, and the current worktree.
The default is a dry run.

Options:
  --apply  Perform the reported removals.
  -h  Show this help.
EOF
}

apply=false
case "${1:-}" in
  "") ;;
  --apply) apply=true ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "error: not inside a Git worktree" >&2
  exit 1
}
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)

if ! command -v gh >/dev/null 2>&1; then
  echo "error: gh is required to verify merged pull requests" >&2
  exit 1
fi

origin_url=$(git remote get-url origin 2>/dev/null) || {
  echo "error: cannot read the origin remote" >&2
  exit 1
}
case "$origin_url" in
  git@github.com:*) repo_slug=${origin_url#git@github.com:} ;;
  https://github.com/*) repo_slug=${origin_url#https://github.com/} ;;
  ssh://git@github.com/*) repo_slug=${origin_url#ssh://git@github.com/} ;;
  git://github.com/*) repo_slug=${origin_url#git://github.com/} ;;
  *)
    echo "error: origin is not a supported GitHub remote: $origin_url" >&2
    exit 1
    ;;
esac
repo_slug=${repo_slug%.git}
case "$repo_slug" in
  */*) ;;
  *)
    echo "error: cannot derive owner/repository from origin: $origin_url" >&2
    exit 1
    ;;
esac

echo "Repository: $repo_slug"
if [ "$apply" = true ]; then
  echo "Mode: apply"
else
  echo "Mode: dry-run"
fi

echo "Fetching and pruning remotes..."
git fetch --all --prune || {
  echo "error: fetch failed; nothing was removed" >&2
  exit 1
}

worktree_for_branch() {
  target_branch=$1
  current_path=
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) current_path=${line#worktree } ;;
      "branch refs/heads/"*)
        current_branch=${line#branch refs/heads/}
        if [ "$current_branch" = "$target_branch" ]; then
          printf '%s\n' "$current_path"
          return 0
        fi
        ;;
    esac
  done < <(git worktree list --porcelain)
  return 1
}

merged_pr_for_tip() {
  local branch=$1 oid=$2 candidates associated number head merge url
  local attempt=1
  while [ "$attempt" -le 3 ]; do
    if candidates=$(gh pr list \
      --repo "$repo_slug" --state merged --head "$branch" --limit 100 \
      --json number,headRefOid,mergeCommit,url \
      --jq '.[] | select(.mergeCommit.oid != null) | [.number, .headRefOid, .mergeCommit.oid, .url] | @tsv' \
      2>/dev/null); then
      break
    fi
    attempt=$((attempt + 1))
  done
  [ "$attempt" -le 3 ] || return 1

  # Commit associations also find work published under a different branch name.
  if associated=$(gh api --paginate "repos/$repo_slug/commits/$oid/pulls" \
    --jq '.[] | select(.merged_at != null and .merge_commit_sha != null) | [.number, .head.sha, .merge_commit_sha, .html_url] | @tsv' \
    2>/dev/null); then
    candidates=$(printf '%s\n%s\n' "$candidates" "$associated" | sort -u)
  elif [ -z "$candidates" ]; then
    return 1
  fi

  while IFS=$'\t' read -r number head merge url; do
    [ -n "$number" ] || continue
    # A PR merged into an unmerged stack layer is not yet retained by main.
    [ -n "$main_oid" ] || continue
    git merge-base --is-ancestor "$merge" "$main_oid" 2>/dev/null || continue
    if ! git cat-file -e "$head^{commit}" 2>/dev/null; then
      git fetch --no-tags origin "refs/pull/$number/head" >&2 || continue
      git cat-file -e "$head^{commit}" 2>/dev/null || continue
    fi
    if git merge-base --is-ancestor "$oid" "$head"; then
      printf '%s\t%s\n' "$number" "$url"
      return 0
    fi
  done <<< "$candidates"
  return 0
}

echo
echo "Branch cleanup candidates:"
main_oid=$(git rev-parse --verify refs/remotes/origin/main^{commit} 2>/dev/null || true)
default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
default_branch=${default_branch#origin/}
if [ -z "$default_branch" ]; then
  default_branch=$(gh repo view "$repo_slug" --json defaultBranchRef --jq '.defaultBranchRef.name' 2>/dev/null || true)
fi
if [ -z "$default_branch" ] || [ "$default_branch" = null ]; then
  echo "error: cannot identify the origin default branch; nothing was removed" >&2
  exit 1
fi
branch_candidates=0
while IFS=$'\t' read -r branch oid; do
  [ -n "$branch" ] || continue
  case "$branch" in
    main|master) continue ;;
  esac
  [ "$branch" != "$default_branch" ] || continue

  if [ -n "$main_oid" ] && git merge-base --is-ancestor "$oid" "$main_oid"; then
    branch_candidates=$((branch_candidates + 1))
    reason="fully contained in origin/main"
  else
    branch_candidates=$((branch_candidates + 1))
    if ! pr_matches=$(merged_pr_for_tip "$branch" "$oid"); then
      echo "SKIP branch $branch: could not verify a merged PR for this tip"
      continue
    fi
    pr=$(printf '%s\n' "$pr_matches" | sed -n '1p')
    if [ -z "$pr" ]; then
      echo "SKIP branch $branch: tip is not contained in a verified merged PR head"
      continue
    fi
    reason="contained in merged PR ${pr#*$'\t'}"
  fi

  wt=$(worktree_for_branch "$branch" || true)

  if [ -n "$wt" ]; then
    if [ "$wt" = "$repo_root" ]; then
      echo "SKIP branch $branch: checked out in the current worktree"
      continue
    fi
    if ! wt_status=$(git -C "$wt" status --porcelain); then
      echo "SKIP branch $branch: cannot inspect worktree: $wt"
      continue
    fi
    if [ -n "$wt_status" ]; then
      echo "SKIP branch $branch: worktree is dirty: $wt"
      continue
    fi

    if [ "$apply" = true ]; then
      if git worktree remove "$wt"; then
        echo "REMOVE worktree $wt: $reason"
      else
        echo "SKIP branch $branch: worktree removal failed: $wt"
        continue
      fi
    else
      echo "WOULD REMOVE worktree $wt: $reason"
    fi
  fi

  if [ "$apply" = true ]; then
    if git branch -D -- "$branch" >/dev/null; then
      echo "REMOVE branch $branch: $reason"
    else
      echo "ERROR branch $branch: deletion failed" >&2
    fi
  else
    echo "WOULD REMOVE branch $branch: $reason"
  fi
done < <(
  git for-each-ref \
    --sort=refname \
    --format='%(refname:short)%09%(objectname)' \
    refs/heads
)

if [ "$branch_candidates" -eq 0 ]; then
  echo "None"
fi

echo
echo "Detached worktrees:"
detached_candidates=0
current_path=
current_head=
current_detached=false

inspect_detached_worktree() {
  wt=$1
  head=$2
  [ -n "$wt" ] || return 0
  [ "$current_detached" = true ] || return 0

  detached_candidates=$((detached_candidates + 1))
  if [ "$wt" = "$repo_root" ]; then
    echo "SKIP detached worktree $wt: current worktree"
    return 0
  fi
  if ! wt_status=$(git -C "$wt" status --porcelain); then
    echo "SKIP detached worktree $wt: cannot inspect worktree"
    return 0
  fi
  if [ -n "$wt_status" ]; then
    echo "SKIP detached worktree $wt: dirty"
    return 0
  fi

  containing_ref=$(git for-each-ref \
    --contains="$head" \
    --format='%(refname)' \
    refs/heads refs/remotes | head -n 1)
  if [ -z "$containing_ref" ]; then
    echo "SKIP detached worktree $wt: $head is not reachable from a durable ref"
    return 0
  fi

  if [ "$apply" = true ]; then
    if git worktree remove "$wt"; then
      echo "REMOVE detached worktree $wt: retained by $containing_ref"
    else
      echo "ERROR detached worktree $wt: removal failed" >&2
    fi
  else
    echo "WOULD REMOVE detached worktree $wt: retained by $containing_ref"
  fi
}

while IFS= read -r line; do
  if [ -z "$line" ]; then
    inspect_detached_worktree "$current_path" "$current_head"
    current_path=
    current_head=
    current_detached=false
    continue
  fi

  case "$line" in
    "worktree "*) current_path=${line#worktree } ;;
    "HEAD "*) current_head=${line#HEAD } ;;
    detached) current_detached=true ;;
  esac
done < <(git worktree list --porcelain; printf '\n')

if [ "$detached_candidates" -eq 0 ]; then
  echo "None"
fi

if [ "$apply" = true ]; then
  git --git-dir="$common_dir" worktree prune
else
  git --git-dir="$common_dir" worktree prune --dry-run
fi

if [ "$apply" = false ]; then
  echo
  echo "Dry run complete. Run 'git sweep-gone --apply' to perform these removals."
fi
